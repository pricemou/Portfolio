# Configuration Flask
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-me-in-production

# Identité
PORTFOLIO_NAME=Claude Pricemou
PORTFOLIO_TITLE=Développeur Full Stack & Science des données
PORTFOLIO_EMAIL=contact@example.com
PORTFOLIO_DESCRIPTION=Développeur Full Stack et science des données à Trois-Rivières
SITE_URL=https://claude225.pythonanywhere.com

# Serveur local
HOST=127.0.0.1
PORT=5000

# SQLite
SQLITE_DB_PATH=portfolio.db

# ---------------------------------------------------------------------------
# Sécurité / sessions
# Local (http://127.0.0.1) : Secure=False, HSTS=False
# Production (HTTPS)       : Secure=True,  HSTS=True
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECURE=False
ENABLE_HSTS=False
SESSION_HOURS=8
IP_HASH_SALT=change-me-ip-salt

# Admin (changez le mot de passe dès le premier déploiement)
# Connexion via ADMIN_EMAIL (plus via le nom d'utilisateur)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Email / alertes sécurité (SMTP)
# Les alertes (ex. ≥5 échecs de login) partent vers NOTIFICATION_EMAIL.
# Gmail : utilisez un « mot de passe d'application », pas le mot de passe du compte.
# ---------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Exemple production (PythonAnywhere / HTTPS) — à mettre dans .env distant
# FLASK_ENV=production
# DEBUG=False
# SESSION_COOKIE_SECURE=True
# ENABLE_HSTS=True
# SITE_URL=https://votre-domaine.example
# ---------------------------------------------------------------------------
